{
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "150ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "250ms" }
  },
  "ease": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } },
  "font": {
    "$type": "fontFamily",
    "serif": { "$value": ["Newsreader Variable", "Georgia", "serif"] },
    "sans": { "$value": ["Inter Variable", "system-ui", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": { "fontFamily": "{font.serif}", "fontSize": "40px", "lineHeight": "48px", "fontWeight": 600 }
    },
    "headline-l": {
      "$value": { "fontFamily": "{font.serif}", "fontSize": "32px", "lineHeight": "40px", "fontWeight": 600 }
    },
    "headline-m": {
      "$value": { "fontFamily": "{font.serif}", "fontSize": "24px", "lineHeight": "32px", "fontWeight": 600 }
    },
    "headline-s": {
      "$value": { "fontFamily": "{font.serif}", "fontSize": "20px", "lineHeight": "28px", "fontWeight": 600 }
    },
    "title": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600 }
    },
    "body-l": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "18px", "lineHeight": "28px", "fontWeight": 400 }
    },
    "body-m": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "15px", "lineHeight": "24px", "fontWeight": 400 }
    },
    "label": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 500 }
    },
    "caption": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400 }
    }
  }
}
