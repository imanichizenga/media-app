{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": { "outputs": ["dist/**", "src/generated/**"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_PROXY_TARGET", "REALTIME_PROXY_TARGET"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["build"] }
  }
}
